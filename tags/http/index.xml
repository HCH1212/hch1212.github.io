 &lt;td&gt;长连接&lt;/td&gt;
 &lt;td&gt;长连接&lt;/td&gt;
 &lt;td&gt;QUIC 长连接&lt;/td&gt;
 &lt;/tr&gt;
 &lt;tr&gt;
 &lt;td&gt;数据格式&lt;/td&gt;
 &lt;td&gt;文本&lt;/td&gt;
